// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the capability table, row by row 1`] = `
"| encoder    | need                | can   | as                                                                 |
| ---------- | ------------------- | ----- | ------------------------------------------------------------------ |
| sharp      | box                 | true  | resize fit 'cover'                                                 |
| sharp      | position center     | true  | position 'centre'                                                  |
| sharp      | position top        | true  | position 'top'                                                     |
| sharp      | position bottom     | true  | position 'bottom'                                                  |
| sharp      | position left       | true  | position 'left'                                                    |
| sharp      | position right      | true  | position 'right'                                                   |
| sharp      | position attention  | true  | strategy.attention                                                 |
| sharp      | position entropy    | true  | strategy.entropy                                                   |
| sharp      | rotate quarter      | true  | rotate()                                                           |
| sharp      | rotate other        | true  | rotate()                                                           |
| sharp      | flip                | true  | flip()                                                             |
| sharp      | flop                | true  | flop()                                                             |
| sharp      | grayscale           | true  | grayscale()                                                        |
| sharp      | blur                | true  | blur(sigma)                                                        |
| sharp      | sharpen             | true  | sharpen()                                                          |
| sharp      | normalize           | true  | normalize()                                                        |
| sharp      | negate              | true  | negate()                                                           |
| sharp      | gamma               | true  | gamma()                                                            |
| sharp      | tint                | true  | tint()                                                             |
| sharp      | modulate brightness | true  | modulate({ brightness })                                           |
| sharp      | modulate saturation | true  | modulate({ saturation })                                           |
| sharp      | modulate hue        | true  | modulate({ hue })                                                  |
| sharp      | modulate lightness  | true  | modulate({ lightness })                                            |
| sharp      | format avif         | true  | avif()                                                             |
| sharp      | format webp         | true  | webp()                                                             |
| sharp      | format png          | true  | png()                                                              |
| sharp      | format jpeg         | true  | jpeg({ mozjpeg })                                                  |
| cloudflare | box                 | true  | fit=cover                                                          |
| cloudflare | position center     | true  | no gravity (the center is the default)                             |
| cloudflare | position top        | true  | gravity=top                                                        |
| cloudflare | position bottom     | true  | gravity=bottom                                                     |
| cloudflare | position left       | true  | gravity=left                                                       |
| cloudflare | position right      | true  | gravity=right                                                      |
| cloudflare | position attention  | true  | gravity=auto (saliency)                                            |
| cloudflare | position entropy    | false | no gravity keeps the busiest part                                  |
| cloudflare | rotate quarter      | true  | rotate=90\\|180\\|270                                                |
| cloudflare | rotate other        | false | rotate takes 90, 180 or 270 only                                   |
| cloudflare | flip                | true  | flip=v                                                             |
| cloudflare | flop                | true  | flip=h                                                             |
| cloudflare | grayscale           | true  | saturation=0                                                       |
| cloudflare | blur                | true  | blur=<radius 1–250> (twice the sigma)                              |
| cloudflare | sharpen             | true  | sharpen=1                                                          |
| cloudflare | normalize           | false | no option stretches the levels                                     |
| cloudflare | negate              | false | no option inverts the colors                                       |
| cloudflare | gamma               | false | gamma is an exposure curve there, not sharp's gamma-correct resize |
| cloudflare | tint                | false | no option tints                                                    |
| cloudflare | modulate brightness | true  | brightness=<multiplier>                                            |
| cloudflare | modulate saturation | true  | saturation=<multiplier>                                            |
| cloudflare | modulate hue        | false | no option turns the hue                                            |
| cloudflare | modulate lightness  | false | no option adds lightness                                           |
| cloudflare | format avif         | true  | format=avif (WebP or JPEG past 1200 px a side)                     |
| cloudflare | format webp         | true  | format=webp                                                        |
| cloudflare | format png          | true  | format=png                                                         |
| cloudflare | format jpeg         | true  | format=jpeg                                                        |"
`;
